    "comlink": "^4.4.2",
    "element-plus": "^2.14.1",
    "empty-module": "^0.0.2",
    "es-toolkit": "^1.47.0",
    "eventemitter3": "^5.0.4",
    "file-saver": "^2.0.5",
    "human-readable": "^0.2.1",
    "idb-keyval": "^6.2.5",
    "isomorphic-timers-promises": "^1.0.1",
    "js-md5": "^0.8.3",
    "lz4js": "^0.2.0",
    "monaco-editor": "^0.55.1",
    "natsort": "^2.0.3",
    "onnxruntime-web": "^1.19.2",
    "pinia": "^3.0.4",
    "uid": "^2.0.2",
