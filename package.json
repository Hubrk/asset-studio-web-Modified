{
  "name": "asset-studio-web",
  "type": "module",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "postinstall": "node scripts/patch-legacy-cjs.cjs",
    "dev": "vite --force",
    "build": "run-p type-check \"build-only {@}\" --",
    "preview": "vite preview",
    "build-only": "vite build",
    "type-check": "vue-tsc --build --force",
    "analyze": "bunx vite-bundle-visualizer",
    "lint": "eslint",
    "lint:fix": "eslint --fix",
    "format": "prettier --write src/",
    "test": "vitest run",
    "test:watch": "vitest",
    "dev:open": "vite --open",
    "dev:host": "vite --host",
    "dev:8080": "vite --port 8080",
    "build:fast": "vite build",
    "build:analyze": "vite build --mode analyze",
    "preview:open": "vite preview --open",
    "type-check:watch": "vue-tsc --build --watch",
    "lint:all": "eslint .",
    "lint:all:fix": "eslint . --fix",
    "format:check": "prettier --check src/",
    "format:all": "prettier --write .",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest run --coverage",
    "models:download": "node scripts/download-removebg-model.cjs",
    "models:download-fast": "node scripts/download-removebg-1.5-fast.cjs",
    "models:download:all": "run-s models:download models:download-fast",
    "models:verify": "node scripts/verify-removebg-model.cjs",
    "kill:8080": "node scripts/kill-port.cjs 8080",
    "kill:5173": "node scripts/kill-port.cjs 5173",
    "kill:port": "node scripts/kill-port.cjs",
    "clean:dist": "node scripts/clean.cjs dist",
    "clean:cache": "node scripts/clean.cjs node_modules/.vite node_modules/.cache .vite dist-ssr",
    "clean:modules": "node scripts/clean.cjs node_modules packages/unity-js/node_modules",
    "clean:models": "node scripts/clean.cjs public/models",
    "clean:all": "run-s clean:dist clean:cache",
    "reinstall": "run-s clean:modules install",
    "reinstall:bun": "run-s clean:modules \"bun install\"",
    "check": "run-s type-check lint test",
    "prebuild": "run-s clean:dist type-check"
  },
  "dependencies": {
    "@arkntools/unity-js": "file:packages/unity-js",
